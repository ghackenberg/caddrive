{
    "name": "productboard",
    "version": "0.0.1",
    "description": "Web platform for collaborative product design",
    "license": "UNLICENSED",
    "private": "true",
    "author": {
        "name": "Georg Hackenberg",
        "email": "georg.hackenberg@fh-wels.at"
    },
    "contributors": [
        {
            "name": "Georg Hackenberg",
            "email": "georg.hackenberg@fh-wels.at"
        },
        {
            "name": "Christian Zehetner",
            "email": "christian.zehetner@fh-wels.at"
        },
        {
            "name": "Jürgen Humenberger",
            "email": "juergen.humenberger@fh-wels.at"
        },
        {
            "name": "Dominik Frühwirth",
            "email": "dominik.fruehwirth@fh-wels.at"
        }
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/ghackenberg/caddrive.git"
    },
    "workspaces": [
        "packages/codeaster",
        "packages/ldraw",
        "packages/brep",
        "packages/freecad",
        "packages/common",
        "packages/database",
        "packages/broker",
        "packages/backend",
        "packages/worker",
        "packages/frontend",
        "packages/gateway"
    ],
    "scripts": {
        "clean": "npm run clean --workspaces --if-present",
        "build": "npm run build --workspaces --if-present",
        "lint": "npm run lint --workspaces",
        "loc": "npm run loc --workspaces",
        "dev": "concurrently --kill-others --prefix-colors auto --pad-prefix --names backend,broker,worker,frontend,gateway \"npm:dev:backend\" \"npm:dev:broker\" \"npm:dev:worker\" \"npm:dev:frontend\" \"npm:dev:gateway\"",
        "dev:backend": "npm run dev -w packages/backend",
        "dev:broker": "npm run dev -w packages/broker",
        "dev:worker": "npm run dev -w packages/worker",
        "dev:frontend": "npm run dev -w packages/frontend",
        "dev:gateway": "npm run dev -w packages/gateway",
        "start": "concurrently --kill-others --prefix-colors auto --pad-prefix --names backend,broker \"npm:start:backend\" \"npm:start:broker\"",
        "start:backend": "npm start -w packages/backend",
        "start:broker": "npm start -w packages/broker",
        "migration:generate": "npm run migration:generate -w packages/database",
        "migration:create": "npm run migration:create -w packages/database",
        "migration:run": "npm run migration:run -w packages/database",
        "migration:revert": "npm run migration:revert -w packages/database",
        "migration:show": "npm run migration:show -w packages/database"
    },
    "dependencies": {
        "@nestjs/common": "^11.1.9",
        "@nestjs/core": "^11.1.9",
        "@nestjs/swagger": "^11.2.3",
        "@types/express": "^5.0.6",
        "@types/node": "^25.0.3",
        "@types/shortid": "^2.2.0",
        "@types/three": "^0.182.0",
        "@zip.js/zip.js": "^2.8.11",
        "axios": "^1.13.2",
        "express": "^5.2.1",
        "jose": "^6.1.3",
        "mqtt": "^5.14.1",
        "opencascade.js": "^2.0.0-beta.b5ff984",
        "reflect-metadata": "^0.2.2",
        "rehype-mermaid": "^3.0.0",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "shortid": "^2.2.17",
        "three": "^0.182.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "unified": "^11.0.5"
    },
    "devDependencies": {
        "concurrently": "^9.2.1",
        "css-loader": "^7.1.2",
        "eslint": "^9.39.2",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-regex": "^1.10.0",
        "html-webpack-plugin": "^5.6.5",
        "playwright": "^1.57.0",
        "rimraf": "^6.1.2",
        "sloc": "^0.3.2",
        "style-loader": "^4.0.0",
        "ts-loader": "^9.5.4",
        "type-fest": "^5.3.1",
        "webpack": "^5.104.1",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^5.2.2",
        "webpack-merge": "^6.0.1"
    },
    "engines": {
        "node": "^25",
        "npm": "^11"
    }
}
